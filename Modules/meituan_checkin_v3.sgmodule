[Script]
美团Token抓取 = type=http-request,pattern=^https://(market\\.waimai|mediacps)\\.meituan\\.com,requires-body=false,script-path=https://raw.githubusercontent.com/AllenJhon/Surge/main/Modules/meituan_checkin_v3.js,timeout=30
美团神券领取 = type=cron,cronexp="0 5 11 * * *",wake-system=true,script-path=https://raw.githubusercontent.com/AllenJhon/Surge/main/Modules/meituan_checkin_v3.js,timeout=120

[MITM]
hostname = %APPEND% market.waimai.meituan.com, mediacps.meituan.com
