#!name=蜜雪冰城签到
#!desc=蜜雪冰城每日签到 + 雪王铺任务（Sliverkiss，原模块补了每日定时签到）

[Script]
蜜雪冰城获取token = type=http-response, pattern=^https:\/\/mxsa\.mxbc\.net\/api\/v1\/customer\/info, script-path=https://gist.githubusercontent.com/Sliverkiss/865c82e42a5730bb696f6700ebb94cee/raw/mxbc.js, requires-body=true, timeout=60
蜜雪冰城签到 = type=cron, cronexp=0 8 * * *, script-path=https://gist.githubusercontent.com/Sliverkiss/865c82e42a5730bb696f6700ebb94cee/raw/mxbc.js, timeout=60

[MITM]
hostname = %APPEND% mxsa.mxbc.net
