#!name=酷狗概念版签到
#!desc=酷狗概念版每日自动领 VIP：先在 App 内点一次领取抓 token，之后每天 08:00/08:10 自动听歌+领 VIP
#!author=AllenJhon
#!homepage=https://github.com/AllenJhon/Surge
#!date=2026-11-24

[Script]
酷狗概念版抓包 = type=http-request, pattern=^https://gateway\.kugou\.com/(youth/(v1/ad/play_report|v2/report/listen_song)|v3/get_my_info), requires-body=true, script-path=https://raw.githubusercontent.com/AllenJhon/Surge/main/Modules/kugou_checkin.js, timeout=10
酷狗概念版签到 = type=cron, cronexp="0 8 * * *", wake-system=1, script-path=https://raw.githubusercontent.com/AllenJhon/Surge/main/Modules/kugou_checkin.js, timeout=180
酷狗概念版签到补领 = type=cron, cronexp="10 8 * * *", wake-system=1, script-path=https://raw.githubusercontent.com/AllenJhon/Surge/main/Modules/kugou_checkin.js, timeout=180

[MITM]
hostname = %APPEND% gateway.kugou.com
