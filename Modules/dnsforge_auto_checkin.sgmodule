[Script]
DNSForge抓包 = type=http-response,pattern=^https:\/\/adguardhome\.lv10\.ren\/api\/v1\/auth\/(login|refresh),requires-body=true,script-path=https://hub.hin0ka.com/scripts/DNSForge/dnsforge-surge.js,timeout=30
DNSForge签到 = type=cron,cronexp="0 8 * * *",wake-system=true,script-path=https://hub.hin0ka.com/scripts/DNSForge/dnsforge-surge.js,timeout=120

[MITM]
hostname = %APPEND% adguardhome.lv10.ren
